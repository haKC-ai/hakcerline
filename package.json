{
  "name": "hakcerline",
  "version": "0.3.0",
  "description": "Animated hacker statusline for Claude Code. 47 themed scenes. Stateless. Zero runtime deps.",
  "type": "module",
  "bin": {
    "hakcerline": "dist/index.js"
  },
  "files": [
    "dist/",
    "scenes/",
    "assets/banner.txt",
    "assets/banner.gif",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc || true",
    "prerender": "python3 scripts/prerender.py",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Cory Kennedy <cory@darkcode.llc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haKC-ai/hakcerline.git"
  },
  "bugs": {
    "url": "https://github.com/haKC-ai/hakcerline/issues"
  },
  "homepage": "https://github.com/haKC-ai/hakcerline#readme",
  "keywords": [
    "claude-code",
    "statusline",
    "terminal",
    "hacker",
    "ascii",
    "animation",
    "cli",
    "nfo",
    "bbs"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
